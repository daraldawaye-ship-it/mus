# Dedicated market API: no sales workers, company migrations, or frontend process.
FROM node:24.19.0-bookworm-slim AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY apps/api/market-migrations/001_market.sql apps/api/market-migrations/20261116_card_statistics.sql apps/api/market-migrations/20261117_card_rating_statistics.sql apps/api/market-migrations/20261127_agent_manufacturer_statistics.sql ./apps/api/market-migrations/
COPY apps/api/test/market-card-statistics.test.mjs ./apps/api/test/
RUN node --test apps/api/test/market-card-statistics.test.mjs && npm prune --omit=dev
FROM node:24.19.0-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package.json ./
COPY --chown=node:node apps/api ./apps/api
COPY --chown=node:node packages/contracts ./packages/contracts
USER node
EXPOSE 3000
CMD ["node", "--import", "tsx", "apps/api/src/market/index.ts"]
