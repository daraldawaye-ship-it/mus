{
  "name": "tijara",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx apps/api/src/index.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "npm run build && tsx tests/browser.ts",
    "db:start": "bash scripts/postgres.sh start",
    "db:stop": "bash scripts/postgres.sh stop",
    "owner:create": "tsx apps/api/src/owner.ts",
    "start": "NODE_ENV=production tsx apps/api/src/index.ts",
    "test:browser:finance": "npm run build && tsx tests/browser-finance.ts",
    "test:browser:items": "npm run build && tsx tests/browser-items.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.64.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
